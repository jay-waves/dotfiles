<service>
  <id>mihomo</id>
  <name>mihomo</name>
  <description>mihomo proxy core</description>

  <executable>D:\bin\mihomo.exe</executable>
  <arguments>-d C:\Users\jay-waves\AppData\Local\mihomo</arguments>
  <workingdirectory>C:\Users\jay-waves\AppData\Local\mihomo</workingdirectory>

  <logpath>C:\Users\jay-waves\AppData\Local\mihomo</logpath>
  <log mode="reset"/>

  <startmode>Automatic</startmode>

  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="10 sec"/>
