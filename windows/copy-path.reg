Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\*\shell\CopySelectedPaths]
"MUIVerb"="Copy path(s)"
"Icon"="D:\\bin\\Win\\copy_path.exe"
"MultiSelectModel"="Player"

[HKEY_CURRENT_USER\Software\Classes\*\shell\CopySelectedPaths\command]
@="\"D:\\bin\\Win\\copy_path.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\CopySelectedPaths]
"MUIVerb"="Copy path(s)"
"Icon"="D:\\bin\\Win\\copy_path.exe"
"MultiSelectModel"="Player"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\CopySelectedPaths\command]
@="\"D:\\bin\\Win\\copy_path.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\CopyCurrentFolderPath]
"MUIVerb"="Copy current folder path"
"Icon"="D:\\bin\\Win\\copy_path.exe"

[HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\CopyCurrentFolderPath\command]
@="\"D:\\bin\\Win\\copy_path.exe\" \"%V\""